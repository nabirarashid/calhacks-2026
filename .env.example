# Names only. Real values go in ~/.darwin_secrets.sh (outside the repo), loaded with:  source ~/.darwin_secrets.sh
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_ACCOUNT_LABEL=          # prod | dev-<name>
ONSHAPE_CALLS_REMAINING=        # read off Onshape's usage page
ONSHAPE_CALLS_REMAINING_AT=     # ISO time of that reading
DARWIN_ONSHAPE_RESERVE=400      # hard floor; refuse calls below it
DARWIN_ALLOW_RESERVE=0          # set to 1 ONLY at the judging table
DARWIN_FIN_DOC_URL=             # Onshape Part Studio URL (per account)
DARWIN_ONSHAPE_WRITE=0          # 1 only for an approved handoff
DARWIN_ONSHAPE_WRITE_ISOLATED=0 # 1 only for a disposable/isolated workspace
DARWIN_ONSHAPE_WRITE_TARGET_URL= # must exactly identify the acknowledged /w/ target
DEEPSEEK_API_KEY=               # default LLM: set this and DeepSeek is used automatically
ANTHROPIC_API_KEY=              # optional: Claude, used when DeepSeek's key is unset or the provider says so
DARWIN_LLM_PROVIDER=            # empty = auto (deepseek > anthropic > mock) | deepseek | anthropic | mock | replay
DARWIN_MODEL_FAST=              # empty = provider default (deepseek-flash | claude-haiku-5-5)
DARWIN_MODEL_DEEP=              # empty = provider default (deepseek-v4-pro | claude-sonnet-5-5)
DARWIN_DEEPSEEK_THINKING=0      # 1 = DeepSeek reasons before answering (better maybe, 10x slower: 30-50 s per plan)
DARWIN_SPEND_CAP_TOTAL_USD=4.50
DARWIN_SPEND_CAP_RUN_USD=0.30
DARWIN_LLM_CACHE=0              # 1 = reuse identical LLM responses (rehearsals)
DARWIN_SIM=real                 # real | fake
DARWIN_CAD=real                 # real | fake | off
DARWIN_MODE=live                # live | replay
