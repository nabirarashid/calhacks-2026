{
  "manifest_version": 3,
  "name": "Darwin for Onshape",
  "version": "0.1.0",
  "description": "Opens Darwin beside supported Onshape documents.",
  "permissions": [
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://cad.onshape.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Darwin"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src http://localhost:5173"
  }
}
